# --- Node / Web ---
node_modules/
apps/web/dist/
apps/web/.vite/
*.local

# --- PHP / Laravel ---
apps/api/vendor/
apps/api/node_modules/
apps/api/.phpunit.cache/
apps/api/storage/*.key
apps/api/storage/framework/cache/data/*
apps/api/storage/framework/sessions/*
apps/api/storage/framework/testing/*
apps/api/storage/framework/views/*
apps/api/storage/logs/*
!apps/api/storage/framework/cache/data/.gitignore
!apps/api/storage/framework/sessions/.gitignore
!apps/api/storage/framework/testing/.gitignore
!apps/api/storage/framework/views/.gitignore
!apps/api/storage/logs/.gitignore
apps/api/bootstrap/cache/*.php
!apps/api/bootstrap/cache/.gitignore
apps/api/.phpunit.result.cache

# --- Env files ---
.env
.env.*
!.env.example
!*.env.example
# Templates only, no real values — same reasoning as .env.example above
# (Prompt 55).
!.env.production.example
!*.env.production.example
# No secrets in this one — just localhost Postgres test-DB connection
# details (Prompt 46) — needed for `php artisan test` to work at all on
# a fresh clone, same reasoning as the .env.example exception above.
!apps/api/.env.testing

# --- Backups (real DB dumps, not for source control) ---
/backups/

# --- Editors / OS ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log
npm-debug.log*
