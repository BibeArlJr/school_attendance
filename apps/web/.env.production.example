# Production environment template — Vercel (frontend build-time vars).
#
# These are Vite build-time vars (VITE_* — inlined into the built JS at
# `vercel build` time, not read at runtime), so they go in Vercel's
# dashboard: Project Settings → Environment Variables, scoped to
# "Production". This file is NOT read by Vite directly and is NOT meant
# to be filled in and committed with real values.
#
# See docs/operations/deployment.md for the full Render + Vercel + Neon
# setup walkthrough this file is a companion to.

# The deployed Render backend's own public URL, with /api appended —
# e.g. https://school-erp-api.onrender.com/api
VITE_API_URL=

# Mock-service pattern flags (docs/architecture/service-pattern.md).
# Gate feed's real implementation exists and polls a real endpoint
# (RealGateFeedService) — safe to flip to false. Notifications' real
# implementation does NOT exist yet (getNotificationService() throws
# "Real NotificationService is not implemented" if this is set to
# false) — DO NOT change this one until a real implementation ships, or
# the dashboard's mount-time notify() call will throw.
VITE_USE_MOCK_NOTIFICATIONS=true
VITE_USE_MOCK_GATE_FEED=false

# Error monitoring (Prompt 45) — a separate Sentry project from the
# backend's (frontend vs. backend errors, one DSN each). Empty/unset
# means the SDK simply never initializes.
VITE_SENTRY_DSN=
