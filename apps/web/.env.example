VITE_API_URL=http://localhost:8000/api

# Mock-service pattern flags — see docs/architecture/service-pattern.md.
# 'false' switches to the real implementation once one exists.
VITE_USE_MOCK_NOTIFICATIONS=true
VITE_USE_MOCK_GATE_FEED=true

# Error monitoring (Prompt 45) — empty/unset means the Sentry SDK simply
# never initializes: no errors, no crash.
VITE_SENTRY_DSN=
