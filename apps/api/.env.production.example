# Production environment template — Render (backend) + Neon (database).
#
# This is NOT a file to commit with real values, and it is NOT read by
# the app directly (Laravel only ever reads `.env`, which stays
# git-ignored). Paste these into Render's dashboard (Environment tab) for
# the web service, one variable at a time — Render injects them as real
# process env vars at runtime, the same as a local .env would.
#
# See docs/operations/deployment.md for the full Render + Vercel + Neon
# setup walkthrough this file is a companion to.

APP_NAME="School Attendance System"
APP_ENV=production
# Generate once locally with `php artisan key:generate --show` (do not
# reuse the local dev APP_KEY) and paste the output here. Rotating this
# invalidates every existing session/encrypted value (sms_provider_configs
# credentials, sms_templates overrides) — treat it as a one-time value
# for this deployment, not something to regenerate casually.
APP_KEY=
APP_DEBUG=false
# The backend's own public Render URL, e.g. https://school-erp-api.onrender.com
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database (Neon) ---
# Neon's dashboard gives you a single connection string
# (postgresql://user:password@host/dbname?sslmode=require) — paste it
# here as-is. Laravel's pgsql connection reads DB_URL (config/database.php)
# and parses host/port/database/username/password/sslmode out of it, so
# the individual DB_* vars below are NOT needed when DB_URL is set.
DB_CONNECTION=pgsql
DB_URL=
# DB_SSLMODE=require is already implied by "?sslmode=require" in the URL
# above — only set these individually if you did NOT use DB_URL:
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSLMODE=require

# The deployed Vercel frontend's production URL — no trailing slash.
# CORS (config/cors.php) allows exactly this one origin; Vercel preview
# deployments (different sub-domains per branch/PR) will NOT be covered
# by a single value here. Update this if the production Vercel domain
# changes.
FRONTEND_URL=https://your-app.vercel.app

# Sessions aren't used cross-origin (token auth via Sanctum, see
# config/cors.php's supports_credentials: false / ADR 0002) — these
# only matter for Laravel's own internal session use, database-backed
# either way.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database

# KNOWN LIMITATION, not fixed by this env var: every Storage:: call in
# this app names its disk explicitly (grep confirms it — none read
# config('filesystems.default')), so FILESYSTEM_DISK below is inert
# today; it's set for correctness/documentation, not because changing it
# does anything yet. In particular, school logo uploads
# (SettingsController::uploadLogo()) hardcode Storage::disk('public').
# Render's web service filesystem is ephemeral (a redeploy or a
# free-tier spin-down/spin-up cycle wipes local disk), so uploaded
# logos WILL be lost until that controller is
# changed to write through the s3 disk that's already scaffolded in
# config/filesystems.php (Cloudflare R2's free tier — 10GB storage, no
# egress fees — is a reasonable no-cost target). That code change is
# real but is deliberately NOT bundled into this deployment-prep prompt:
# it touches the logo storage/URL/delete logic and needs its own
# verification against a real bucket, not something to ship unverified.
# Tracked as a real gap in docs/operations/deployment.md, not silently
# left implicit.
FILESYSTEM_DISK=local

MAIL_MAILER=log

# Real driver's credentials live in sms_provider_configs (encrypted DB
# storage, Prompt 43) — set/rotate them via that table (e.g. `php artisan
# tinker` against the production DB), not here. This just selects which
# implementation the container resolves (Prompt 54 — this app is
# permanently on 'real' since Prompt 54; keep it that way here too unless
# intentionally testing).
SMS_DRIVER=real

# Error monitoring (Prompt 45) — get this from sentry.io (a free account
# covers a single low-traffic project). Empty/unset means the SDK simply
# never initializes — no crash either way.
SENTRY_LARAVEL_DSN=

# Shared secret for POST /api/tasks/* (Prompt 55 Part E) — generate a
# long random value (e.g. `openssl rand -hex 32`) and configure the same
# value in whatever external cron-ping service or GitHub Actions
# workflow calls that endpoint (X-Scheduled-Task-Secret header). Left
# unset, every call to /api/tasks/* is rejected — see
# VerifyScheduledTaskSecret.
SCHEDULED_TASK_SECRET=
