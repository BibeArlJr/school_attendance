APP_NAME="School Attendance System"
APP_ENV=production

APP_KEY=
APP_DEBUG=false
# The backend's own public Render URL, e.g. https://school-erp-api.onrender.com
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=

FRONTEND_URL=https://your-app.vercel.app

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

# Persistent upload storage (school logos) — Backblaze B2, S3-compatible.
# Render's own disk is ephemeral (wiped on every redeploy/spin-down),
# which is the real reason uploaded logos previously vanished; this is
# the fix. UPLOADS_DISK=b2 switches config/filesystems.php's
# uploads_disk away from its 'public' (local disk) default. Get real
# values from the Backblaze B2 dashboard (Application Keys) — never
# commit them anywhere, including this file.
UPLOADS_DISK=b2
B2_KEY_ID=
B2_APPLICATION_KEY=
# The region segment of the S3-compatible endpoint Backblaze shows for
# this bucket, e.g. ca-east-006 — not a generic AWS region name.
B2_REGION=
B2_BUCKET=
# Full URL including scheme, e.g. https://s3.ca-east-006.backblazeb2.com
B2_ENDPOINT=

MAIL_MAILER=log

SMS_DRIVER=real

SENTRY_LARAVEL_DSN=

SCHEDULED_TASK_SECRET=
