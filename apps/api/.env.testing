APP_ENV=testing
APP_KEY=base64:M+lJc+VZoQgrJBG9M4TJIdssqLwLrK9WzVbmgCHjVfk=
APP_DEBUG=true

# Real Postgres, not SQLite in-memory (Prompt 46) — this app relies on
# real Postgres features (Prompt 5's partial unique index on
# is_primary_contact, JSON columns) that SQLite doesn't correctly
# exercise. A DEDICATED database, never the dev database with its 402
# real students — RefreshDatabase migrates this schema fresh for every
# test run and truncates between tests, which must never happen to
# school_erp.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
# See apps/api/.env's comment — 5432 on this machine is an unrelated
# Docker container, not this project's Postgres.
DB_PORT=5433
DB_DATABASE=school_erp_test
DB_USERNAME=bibekaryal
DB_PASSWORD=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
MAIL_MAILER=array

BCRYPT_ROUNDS=4

SMS_DRIVER=mock
SENTRY_LARAVEL_DSN=

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
